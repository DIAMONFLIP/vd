-- ฟังก์ชันตรวจสอบบทบาทเพื่อแยกสี (ฆาตกร = แดง, ผู้รอดชีวิต/ตำรวจ = น้ำเงิน)
local function getRoleColor(player, character)
   if character:GetAttribute("IsKiller") or character:GetAttribute("Killer") or character:GetAttribute("Murderer") then
      return Color3.fromRGB(255, 50, 50) -- สีแดง (Killer/Murderer)
   end
   
   local backpack = player:FindFirstChild("Backpack")
   for _, container in ipairs({character, backpack}) do
      if container then
         for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
               local tName = string.lower(item.Name)
               if tName:find("knife") or tName:find("sword") or tName:find("bat") or tName:find("weapon") then
                  return Color3.fromRGB(255, 50, 50) -- สีแดง (ถืออาวุธฆาตกร)
               end
            end
         end
      end
   end
   
   return Color3.fromRGB(50, 150, 255) -- สีฟ้า/น้ำเงิน (Survivor / Sheriff)
end

local function setupPlayerAura(player)
   if player == LocalPlayer then return end
   
   local function applyAura(char)
      if not char then return end
      local hl = char:FindFirstChild("BillyzPlayerAura")
      if not hl then
         hl = Instance.new("Highlight")
         hl.Name = "BillyzPlayerAura"
         hl.Adornee = char
         hl.FillTransparency = 0.4
         hl.OutlineTransparency = 0
         hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
         hl.Enabled = playerEspEnabled
         hl.Parent = char
      end
      
      -- อัปเดตสีตามบทบาทแบบเรียลไทม์
      task.spawn(function()
         while char and char.Parent and hl.Parent do
            if playerEspEnabled then
               hl.Enabled = true
               hl.FillColor = getRoleColor(player, char)
               hl.OutlineColor = hl.FillColor
            else
               hl.Enabled = false
            end
            task.wait(1.0)
         end
      end)
   end

   player.CharacterAdded:Connect(applyAura)
   if player.Character then applyAura(player.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayerAura(p) end
Players.PlayerAdded:Connect(setupPlayerAura)


