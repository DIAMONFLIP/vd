local function applyHighlight(object, colorName, isEnabled)
   local hl = object:FindFirstChild("BillyzAura")
   if isEnabled then
      if not hl then
         hl = Instance.new("Highlight")
         hl.Name = "BillyzAura"
         hl.Adornee = object
         hl.FillTransparency = 0.4
         hl.OutlineTransparency = 0
         hl.Parent = object
      end
      hl.FillColor = colorName
      hl.OutlineColor = colorName
   else
      if hl then
         hl:Destroy()
      end
   end
end

RunService.RenderStepped:Connect(function()
   for _, obj in ipairs(workspace:GetDescendants()) do
      local nameLower = string.lower(obj.Name)
      
      if (string.find(nameLower, "generator") or string.find(nameLower, "gen")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
         applyHighlight(obj, generatorColor, survivalSettings.GeneratorESP)
      end
      
      if (string.find(nameLower, "window") or string.find(nameLower, "vault")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
         applyHighlight(obj, windowColor, survivalSettings.WindowESP)
      end
      
      if (string.find(nameLower, "pallet") or string.find(nameLower, "wood")) and not string.find(nameLower, "break") and (obj:IsA("Model") or obj:IsA("BasePart")) then
         applyHighlight(obj, palletColor, survivalSettings.PalletESP)
      end
   end
end)

RunService.RenderStepped:Connect(function()
   if not survivalSettings.AutoParry then return end
   if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
   
   local myRoot = LocalPlayer.Character.HumanoidRootPart
   
   for _, player in ipairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local enemyChar = player.Character
         local enemyRoot = enemyChar.HumanoidRootPart
         
         local isKiller = false
         if enemyChar:GetAttribute("IsKiller") or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Role") and player.leaderstats.Role.Value == "Killer") then
            isKiller = true
         end
         
         if isKiller then
            local distance = (myRoot.Position - enemyRoot.Position).Magnitude
            if distance <= 10 then
               VirtualUser:Button2Down(Vector2.new(0,0), Camera.CFrame)
               task.delay(0.1, function()
                  VirtualUser:Button2Up(Vector2.new(0,0), Camera.CFrame)
