local function setupPlayerAura(player)
   if player == LocalPlayer then return end
   
   player.CharacterAdded:Connect(function(character)
      local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
      if not humanoidRootPart then return end
      
      local oldHl = character:FindFirstChild("BillyzPlayerAura")
      if oldHl then oldHl:Destroy() end
      
      local hl = Instance.new("Highlight")
      hl.Name = "BillyzPlayerAura"
      hl.Adornee = character
      hl.FillTransparency = 0.4
      hl.OutlineTransparency = 0
      hl.Enabled = espSettings.Enabled
      hl.Parent = character
      
      task.spawn(function()
         while character and character.Parent and hl.Parent do
            if espSettings.Enabled then
               hl.Enabled = true
               
               local isKiller = false
               if character:GetAttribute("IsKiller") or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Role") and player.leaderstats.Role.Value == "Killer") then
                  isKiller = true
               end
               
               local auraColor = isKiller and killerAuraColor or survivorAuraColor
               hl.FillColor = auraColor
               hl.OutlineColor = auraColor
            else
               hl.Enabled = false
            end
            task.wait(0.3)
         end
      end)
   end)
   
   if player.Character then
      task.spawn(function()
         local character = player.Character
         local oldHl = character:FindFirstChild("BillyzPlayerAura")
         if oldHl then oldHl:Destroy() end
         
         local hl = Instance.new("Highlight")
         hl.Name = "BillyzPlayerAura"
         hl.Adornee = character
         hl.FillTransparency = 0.4
         hl.OutlineTransparency = 0
         hl.Enabled = espSettings.Enabled
         hl.Parent = character
         
         task.spawn(function()
            while character and character.Parent and hl.Parent do
               if espSettings.Enabled then
                  hl.Enabled = true
                  local isKiller = false
                  if character:GetAttribute("IsKiller") or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Role") and player.leaderstats.Role.Value == "Killer") then
                     isKiller = true
                  end
                  local auraColor = isKiller and killerAuraColor or survivorAuraColor
                  hl.FillColor = auraColor
                  hl.OutlineColor = auraColor
               else
                  hl.Enabled = false
               end
               task.wait(0.3)
            end
         end)
      end)
   end
end

for _, p in ipairs(Players:GetPlayers()) do
   setupPlayerAura(p)
end

Players.PlayerAdded:Connect(setupPlayerAura)

