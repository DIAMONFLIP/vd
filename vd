local function applyGlobalHighlight(object, colorName, isEnabled)
    local hl = object:FindFirstChild("BillyzAura")
    if isEnabled then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "BillyzAura"
            hl.Adornee = object
            hl.FillTransparency = 0.4
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = object
        end
        hl.FillColor = colorName
        hl.OutlineColor = colorName
    else
        if hl then
            hl:Destroy()
        end
    end
end

RunService.RenderStepped:Connect(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local nameLower = string.lower(obj.Name)
        
        if (string.find(nameLower, "generator") or string.find(nameLower, "gen") or string.find(nameLower, "machine") or string.find(nameLower, "coin") or string.find(nameLower, "gun")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
            applyGlobalHighlight(obj, generatorColor, survivalSettings.GeneratorESP)
        end
        
        if (string.find(nameLower, "window") or string.find(nameLower, "vault") or string.find(nameLower, "glass")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
            applyGlobalHighlight(obj, windowColor, survivalSettings.WindowESP)
        end
        
        if (string.find(nameLower, "pallet") or string.find(nameLower, "wood") or string.find(nameLower, "board") or string.find(nameLower, "door") or string.find(nameLower, "gun") or string.find(nameLower, "drop")) and not string.find(nameLower, "break") and (obj:IsA("Model") or obj:IsA("BasePart")) then
            applyGlobalHighlight(obj, palletColor, survivalSettings.PalletESP)
        end
    end
end)


