ESPTab:CreateSection("1. Player ESP (ออร่าผู้เล่นแยกสี)")

local playerEspEnabled = false

local function getRoleColor(player, character)
   if character:GetAttribute("IsKiller") or character:GetAttribute("Killer") or character:GetAttribute("Murderer") then
      return Color3.fromRGB(255, 50, 50) -- สีแดง (Killer)
   end
   
   local backpack = player:FindFirstChild("Backpack")
   for _, container in ipairs({character, backpack}) do
      if container then
         for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
               local tName = string.lower(item.Name)
               if tName:find("knife") or tName:find("sword") or tName:find("bat") or tName:find("weapon") then
                  return Color3.fromRGB(255, 50, 50) -- สีแดง
               elseif tName:find("revolver") or tName:find("gun") then
                  return Color3.fromRGB(50, 255, 50) -- สีเขียว (Sheriff)
               end
            end
         end
      end
   end
   
   return Color3.fromRGB(50, 150, 255) -- สีฟ้า (Survivor)
end

local function updatePlayerESP()
   for _, player in ipairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character then
         local char = player.Character
         local hl = char:FindFirstChild("BillyzESP")
         
         if playerEspEnabled then
            if not hl then
               hl = Instance.new("Highlight")
               hl.Name = "BillyzESP"
               hl.Adornee = char
               hl.FillTransparency = 0.4
               hl.OutlineTransparency = 0
               hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               hl.Parent = char
            end
            local color = getRoleColor(player, char)
            hl.FillColor = color
            hl.OutlineColor = color
            hl.Enabled = true
         else
            if hl then hl:Destroy() end
         end
      end
   end
end

ESPTab:CreateToggle({
   Name = "Enable Player ESP (มองผู้เล่นทะลุกำแพง)",
   CurrentValue = false,
   Callback = function(Value)
      playerEspEnabled = Value
      updatePlayerESP()
   end,
})

-- ลูปอัปเดตสี/ผู้เล่นเกิดใหม่ แบบไม่กิน FPS
task.spawn(function()
   while true do
      if playerEspEnabled then
         updatePlayerESP()
      end
      task.wait(1.0)
   end
end)


ESPTab:CreateSection("2. Map ESP (เครื่องปั่นไฟ / วัตถุ)")

local genEspEnabled = false
local itemEspEnabled = false

local function scanMapObjects()
   for _, obj in ipairs(workspace:GetDescendants()) do
      if obj:IsA("Model") or obj:IsA("BasePart") then
         local n = string.lower(obj.Name)
         
         -- เครื่องปั่นไฟ / Objective / เครื่องจักร
         if genEspEnabled and (n:find("generator") or n:find("gen") or n:find("machine") or n:find("engine") or n:find("objective") or n:find("coin")) then
            local hl = obj:FindFirstChild("BillyzMapGenESP")
            if not hl then
               hl = Instance.new("Highlight")
               hl.Name = "BillyzMapGenESP"
               hl.Adornee = obj
               hl.FillColor = Color3.fromRGB(230, 200, 50) -- สีเหลือง
               hl.FillTransparency = 0.4
               hl.OutlineTransparency = 0
               hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               hl.Parent = obj
            end
         end
         
         -- ไอเทม / ไม้พับ / ปืน / หน้าต่าง
         if itemEspEnabled and (n:find("pallet") or n:find("wood") or n:find("board") or n:find("gun") or n:find("drop") or n:find("window")) and not n:find("break") then
            local hl = obj:FindFirstChild("BillyzMapItemESP")
            if not hl then
               hl = Instance.new("Highlight")
               hl.Name = "BillyzMapItemESP"
               hl.Adornee = obj
               hl.FillColor = Color3.fromRGB(255, 120, 0) -- สีส้ม
               hl.FillTransparency = 0.4
               hl.OutlineTransparency = 0
               hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
               hl.Parent = obj
            end
         end
      end
   end
end

ESPTab:CreateToggle({
   Name = "ESP Generators / Objectives (เครื่องปั่นไฟ)",
   CurrentValue = false,
   Callback = function(Value)
      genEspEnabled = Value
      if Value then
         scanMapObjects()
      else
         for _, obj in ipairs(workspace:GetDescendants()) do
            local hl = obj:FindFirstChild("BillyzMapGenESP")
            if hl then hl:Destroy() end
         end
      end
   end,
})

ESPTab:CreateToggle({
   Name = "ESP Items / Pallets / Guns (ไม้พับ/ปืน/หน้าต่าง)",
   CurrentValue = false,
   Callback = function(Value)
      itemEspEnabled = Value
