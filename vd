local function getPlayerRole(player, character)
    if character:GetAttribute("IsKiller") or character:GetAttribute("Killer") or character:GetAttribute("Murderer") then
        return "Killer"
    end
    if character:GetAttribute("Sheriff") then
        return "Sheriff"
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local role = leaderstats:FindFirstChild("Role") or leaderstats:FindFirstChild("Team")
        if role then
            local rVal = string.lower(tostring(role.Value))
            if rVal:find("killer") or rVal:find("murderer") or rVal:find("ฆาตกร") then
                return "Killer"
            elseif rVal:find("sheriff") or rVal:find("ตำรวจ") then
                return "Sheriff"
            end
        end
    end
    
    local backpack = player:FindFirstChild("Backpack")
    local containers = {character, backpack}
    
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local tName = string.lower(item.Name)
                    if tName:find("knife") or tName:find("revolver") or tName:find("gun") then
                        if tName:find("knife") then return "Killer" end
                        if tName:find("gun") or tName:find("revolver") then return "Sheriff" end
                    end
                    if tName:find("sword") or tName:find("bat") or tName:find("weapon") then
                        return "Killer"
                    end
                end
            end
        end
    end
    
    return "Survivor"
end

local function setupPlayerAura(player)
    if player == LocalPlayer then return end
    
    player.CharacterAdded:Connect(function(character)
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
        if not humanoidRootPart then return end
        
        local oldHl = character:FindFirstChild("BillyzPlayerAura")
        if oldHl then oldHl:Destroy() end
        
        local hl = Instance.new("Highlight")
        hl.Name = "BillyzPlayerAura"
        hl.Adornee = character
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Enabled = espSettings.Enabled
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character
        
        task.spawn(function()
            while character and character.Parent and hl.Parent do
                if espSettings.Enabled then
                    hl.Enabled = true
                    local role = getPlayerRole(player, character)
                    
                    local auraColor = survivorAuraColor
                    if role == "Killer" then
                        auraColor = killerAuraColor
                    elseif role == "Sheriff" then
                        auraColor = sheriffAuraColor
                    end
                    
                    hl.FillColor = auraColor
                    hl.OutlineColor = auraColor
                else
                    hl.Enabled = false
                end
                task.wait(0.5)
            end
        end)
    end)
    
    if player.Character then
        task.spawn(function()
            local character = player.Character
            local oldHl = character:FindFirstChild("BillyzPlayerAura")
            if oldHl then oldHl:Destroy() end
            
            local hl = Instance.new("Highlight")
            hl.Name = "BillyzPlayerAura"
            hl.Adornee = character
            hl.FillTransparency = 0.4
            hl.OutlineTransparency = 0
            hl.Enabled = espSettings.Enabled
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = character
            
            task.spawn(function()
                while character and character.Parent and hl.Parent do
                    if espSettings.Enabled then
                        hl.Enabled = true
                        local role = getPlayerRole(player, character)
                        
                        local auraColor = survivorAuraColor
                        if role == "Killer" then
                            auraColor = killerAuraColor
                        elseif role == "Sheriff" then
                            auraColor = sheriffAuraColor
                        end
                        
                        hl.FillColor = auraColor
                        hl.OutlineColor = auraColor
                    else
                        hl.Enabled = false
                    end
                    task.wait(0.5)
                end
            end)
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    setupPlayerAura(p)
end

Players.PlayerAdded:Connect(setupPlayerAura)
